# =============================================================================
# LIVO BACKEND — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# =============================================================================
# DO NOT COMMIT REAL KEYS TO GIT! Copy this file to '.env' locally or add
# these key-value pairs directly in your Render.com Dashboard (Environment tab).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL 15+ via Transaction Pooler)
# -----------------------------------------------------------------------------
# Get these from Supabase Project Settings -> Database -> Connection String (JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_ID.supabase.co:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_SUPABASE_PROJECT_ID
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# HikariCP Pool settings (Tuned for 512MB Render RAM ceiling)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2

# -----------------------------------------------------------------------------
# 2. JWT AUTHENTICATION SECURITY
# -----------------------------------------------------------------------------
# Must be at least 256-bit (32+ character random secret string)
JWT_SECRET=YOUR_SUPER_SECRET_HMAC_SHA256_KEY_MINIMUM_32_CHARS_LONG
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# -----------------------------------------------------------------------------
# 3. AI ENGINES (100% Free Tiers)
# -----------------------------------------------------------------------------
# Google AI Studio (Gemini 1.5/2.0 Flash) - Get from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_QUOTA_PER_DAY=20

# Groq Console (Whisper-large-v3 Speech-to-Text) - Get from https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY

# -----------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (Profile photos & attachments)
# -----------------------------------------------------------------------------
# Get these from Cloudinary Dashboard -> API Keys (https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# -----------------------------------------------------------------------------
# 5. FIREBASE CLOUD MESSAGING (Free Mobile Push Notifications)
# -----------------------------------------------------------------------------
# Get from Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_PROJECT_ID=livo-app
FIREBASE_PRIVATE_KEY_JSON={"type":"service_account","project_id":"..."}

# -----------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080
